// ==========================================
// MÓDULO: CATÁLOGOS AUXILIARES (DEPENDENCIAS)
// ==========================================

Table cat_paises {
  id_pais integer [primary key]
  codigo_iso varchar(3) [unique, not null]
  nombre_pais varchar(100) [not null]
}

Table cat_condiciones_pago {
  id_condicion_pago integer [primary key]
  codigo varchar(50) [unique, not null]
  descripcion varchar(100) [not null]
  dias integer [not null]
}

Table cat_tipos_persona {
  id_tipo_persona integer [primary key]
  codigo varchar(20) [unique, not null]
  nombre varchar(50) [not null]
}

Table cat_tipos_cliente_negocio {
  id_tipo_cliente_negocio integer [primary key]
  codigo varchar(50) [unique, not null]
  nombre varchar(100) [not null]
}

// ==========================================
// MÓDULO: TABLA MAESTRA DE CLIENTES
// ==========================================

Table tbl_clientes {
  id_cliente integer [primary key]
  codigo_cliente varchar(50) [unique, not null]
  id_tipo_persona integer [not null]
  nombre_razon_social varchar(200) [not null]
  nombre_fantasia varchar(150)
  rut_dni varchar(20) [unique, not null]
  direccion varchar(250)
  comuna_ciudad varchar(100)
  id_pais integer [not null]
  id_tipo_cliente_negocio integer [not null]
  id_condicion_pago integer [not null]
  contacto_nombre varchar(100)
  contacto_email varchar(100)
  estado_activo boolean
  created_at timestamp
}

// Relaciones (Foreign Keys)
Ref: tbl_clientes.id_tipo_persona > cat_tipos_persona.id_tipo_persona
Ref: tbl_clientes.id_pais > cat_paises.id_pais
Ref: tbl_clientes.id_tipo_cliente_negocio > cat_tipos_cliente_negocio.id_tipo_cliente_negocio
Ref: tbl_clientes.id_condicion_pago > cat_condiciones_pago.id_condicion_pago